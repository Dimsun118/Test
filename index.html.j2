<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>TCG Market Reports</title>
<style>
:root { color-scheme: light; --bg: #f4f3f0; --card: #fcfcfb; --border: #e2e1dc; --text: #0b0b0b; --muted: #52514e; --accent: #2a78d6; }
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) { color-scheme: dark; --bg: #111110; --card: #1a1a19; --border: #2e2e2c; --text: #f0efec; --muted: #c3c2b7; --accent: #5598e7; }
}
:root[data-theme="dark"] { color-scheme: dark; --bg: #111110; --card: #1a1a19; --border: #2e2e2c; --text: #f0efec; --muted: #c3c2b7; --accent: #5598e7; }
body { margin: 0; background: var(--bg); color: var(--text); font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
main { max-width: 640px; margin: 0 auto; padding: 32px 16px; }
h1 { font-size: 24px; margin: 0 0 4px; }
p { color: var(--muted); margin: 0 0 20px; }
ul { list-style: none; padding: 0; margin: 0; background: var(--card); border: 1px solid var(--border); border-radius: 12px; }
li { border-bottom: 1px solid var(--border); }
li:last-child { border-bottom: 0; }
a { display: block; padding: 12px 16px; color: var(--accent); text-decoration: none; }
a:hover { background: var(--bg); }
</style>
</head>
<body>
<main>
  <h1>TCG market reports</h1>
  <p>One report per week. The newest is at the top.</p>
  <ul>{% for file, date in reports %}<li><a href="{{ file }}">Week ending {{ date }}</a></li>{% endfor %}</ul>
</main>
</body>
</html>
