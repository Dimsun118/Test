<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>TCG Market Report · {{ asof.strftime('%d %b %Y') }}</title>
<style>
:root {
  color-scheme: light;
  --surface-0: #f4f3f0; --surface-1: #fcfcfb; --surface-2: #f0efec; --border: #e2e1dc;
  --text-primary: #0b0b0b; --text-secondary: #52514e; --text-muted: #7a7974;
  --series-1: #2a78d6; --accent: #2a78d6;
  --good: #0ca30c; --warning: #fab219; --serious: #ec835a; --critical: #d03b3b;
}
@media (prefers-color-scheme: dark) {
  :root:where(:not([data-theme="light"])) {
    color-scheme: dark;
    --surface-0: #111110; --surface-1: #1a1a19; --surface-2: #383835; --border: #2e2e2c;
    --text-primary: #f0efec; --text-secondary: #c3c2b7; --text-muted: #8f8e86;
    --series-1: #3987e5; --accent: #5598e7;
  }
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --surface-0: #111110; --surface-1: #1a1a19; --surface-2: #383835; --border: #2e2e2c;
  --text-primary: #f0efec; --text-secondary: #c3c2b7; --text-muted: #8f8e86;
  --series-1: #3987e5; --accent: #5598e7;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--surface-0); color: var(--text-primary);
  font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
main { max-width: 1180px; margin: 0 auto; padding: 24px 16px 64px; }
header h1 { font-size: 26px; margin: 0 0 4px; letter-spacing: -0.01em; }
header p { margin: 0; color: var(--text-secondary); }
nav.toc { display: flex; flex-wrap: wrap; gap: 6px 14px; margin: 16px 0 8px; font-size: 14px; }
a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }
h2 { font-size: 19px; margin: 36px 0 4px; display: flex; align-items: center; gap: 8px; }
h2 .badge { font-size: 12px; font-weight: 600; color: var(--text-secondary); background: var(--surface-2);
  padding: 1px 8px; border-radius: 99px; }
.lede { color: var(--text-secondary); margin: 0 0 12px; font-size: 14px; }
.card { background: var(--surface-1); border: 1px solid var(--border); border-radius: 12px; }
.tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; margin-top: 12px; }
.tile { padding: 14px 16px; }
.tile .k { font-size: 13px; color: var(--text-secondary); }
.tile .v { font-size: 26px; font-weight: 650; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
.tile .s { font-size: 13px; color: var(--text-muted); }
.game-name { font-weight: 600; margin: 20px 0 0; }
.scroll { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: 14px; }
th { text-align: left; font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: .04em;
  color: var(--text-muted); padding: 10px 12px; border-bottom: 1px solid var(--border); white-space: nowrap; }
td { padding: 8px 12px; border-bottom: 1px solid var(--border); vertical-align: middle; }
tr:last-child td { border-bottom: 0; }
td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
.item { display: flex; gap: 10px; align-items: center; min-width: 220px; }
.item img { width: 34px; height: 47px; object-fit: cover; border-radius: 3px; background: var(--surface-2); flex: none; }
.item .nm { font-weight: 550; }
.item .meta { font-size: 12.5px; color: var(--text-secondary); }
.tag { display: inline-block; font-size: 11.5px; padding: 0 7px; border-radius: 99px; margin: 2px 4px 0 0;
  background: var(--surface-2); color: var(--text-secondary); white-space: nowrap; }
.delta { white-space: nowrap; }
.ic { font-size: 10px; margin-right: 4px; position: relative; top: -1px; }
.ic.up { color: var(--good); } .ic.down { color: var(--critical); } .ic.flat { color: var(--text-muted); }
.na { color: var(--text-muted); font-size: 13px; }
.spark { display: block; overflow: visible; }
.sig { font-weight: 600; white-space: nowrap; }
.sig::before { content: ""; display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; }
.sig.breakout::before, .sig.climber::before { background: var(--good); }
.sig.rebound::before { background: var(--series-1); }
.sig.peaking::before { background: var(--warning); }
.sig.falling::before { background: var(--critical); }
.empty { padding: 18px; color: var(--text-secondary); font-size: 14px; }
.bar { height: 6px; border-radius: 3px; background: var(--surface-2); overflow: hidden; width: 90px; display: inline-block;
  vertical-align: middle; margin-left: 8px; }
.bar i { display: block; height: 100%; background: var(--series-1); border-radius: 3px; }
.controls { display: flex; flex-wrap: wrap; gap: 8px; padding: 12px; border-bottom: 1px solid var(--border); }
.controls input, .controls select { font: inherit; font-size: 14px; padding: 6px 10px; border-radius: 8px;
  border: 1px solid var(--border); background: var(--surface-0); color: var(--text-primary); }
.controls input { flex: 1 1 220px; }
th[data-k] { cursor: pointer; user-select: none; }
th[data-k]:hover { color: var(--text-primary); }
th .arrow { font-size: 10px; }
.note { font-size: 13px; color: var(--text-secondary); }
.warn { padding: 12px 16px; margin-top: 16px; border-left: 4px solid var(--warning); font-size: 14px; }
footer { margin-top: 48px; font-size: 13px; color: var(--text-muted); }
@media (max-width: 640px) {
  .hide-sm { display: none; }
  td, th { padding: 8px 6px; }
  table { font-size: 13.5px; }
  .tile .v { font-size: 22px; }
  .item { min-width: 150px; }
  .item img { display: none; }
}
</style>
</head>
<body>
<main>
<header>
  <h1>TCG market report</h1>
  <p>{{ game_names }} · week ending {{ asof.strftime('%A %d %B %Y') }} · TCGplayer market prices · items ≥ {{ min_price|money }}</p>
</header>

{% if history_days < 30 %}
<div class="card warn">Only {{ history_days }} days of price history so far, so 30- and 90-day trends are incomplete.
Run <code>python -m tcgtrack update</code> to backfill history from the archive.</div>
{% endif %}

<nav class="toc">
  <a href="#overview">Overview</a>
  {% for key, items in sections %}<a href="#{{ key }}">{{ signal_info[key][0] }} ({{ items|length }})</a>{% endfor %}
  <a href="#sets">Sets</a><a href="#sealed">Sealed</a>
  {% if watched %}<a href="#watchlist">Watchlist</a>{% endif %}
  <a href="#explore">Explore all</a>
</nav>

<section id="overview">
{% for g in games %}
  <p class="game-name">{{ g.name }}</p>
  <div class="tiles">
    <div class="card tile"><div class="k">Rising this week</div>
      <div class="v">{{ '%.0f'|format((g.up or 0) * 100) }}%</div>
      <div class="s">{{ '%.0f'|format((g.down or 0) * 100) }}% falling · {{ '{:,}'.format(g.tracked) }} items</div></div>
    <div class="card tile"><div class="k">Typical 7-day move</div>
      <div class="v">{{ g.median7|delta }}</div><div class="s">median of tracked items</div></div>
    <div class="card tile"><div class="k">Typical 30-day move</div>
      <div class="v">{{ g.median30|delta }}</div><div class="s">median of tracked items</div></div>
    <div class="card tile"><div class="k">Buy signals</div>
      <div class="v">{{ (g.signals.get('breakout', 0)) + (g.signals.get('climber', 0)) }}</div>
      {% set b, c = g.signals.get('breakout', 0), g.signals.get('climber', 0) %}<div class="s">{{ b }} breakout{{ '' if b == 1 else 's' }} · {{ c }} climber{{ '' if c == 1 else 's' }}</div></div>
    <div class="card tile"><div class="k">Sell / avoid signals</div>
      <div class="v">{{ (g.signals.get('peaking', 0)) + (g.signals.get('falling', 0)) }}</div>
      <div class="s">{{ g.signals.get('peaking', 0) }} peaking · {{ g.signals.get('falling', 0) }} falling</div></div>
  </div>
{% endfor %}
</section>

{% macro item_cell(i) %}
<div class="item">
  {% if i.image_url %}<img src="{{ i.image_url }}" alt="" loading="lazy">{% endif %}
  <div>
    <div class="nm">{% if i.url %}<a href="{{ i.url }}" target="_blank" rel="noopener">{{ i.label }}</a>{% else %}{{ i.label }}{% endif %}</div>
    <div class="meta">{{ i.set_name }}{% if i.number %} · #{{ i.number }}{% endif %}{% if i.rarity %} · {{ i.rarity }}{% elif i.kind == 'sealed' %} · Sealed{% endif %}</div>
    {% for t in i.tags %}<span class="tag">{{ t }}</span>{% endfor %}
  </div>
</div>
{% endmacro %}

{% macro item_table(items, show_signal=False) %}
<div class="card scroll"><table>
  <thead><tr><th>Item</th>{% if show_signal %}<th class="hide-sm">Signal</th>{% endif %}<th class="num">Price</th><th class="num">7 days</th>
  <th class="num">30 days</th><th class="num hide-sm">90 days</th><th class="num hide-sm">vs 90d high</th><th class="hide-sm">Last 90 days</th></tr></thead>
  <tbody>
  {% for i in items %}
  <tr>
    <td>{{ item_cell(i) }}</td>
    {% if show_signal %}<td class="hide-sm">{% if i.signal %}<span class="sig {{ i.signal }}">{{ signal_info[i.signal][0] }}</span>{% else %}<span class="na">none</span>{% endif %}</td>{% endif %}
    <td class="num">{{ i.price|money }}</td>
    <td class="num">{{ i.ch7|delta }}</td>
    <td class="num">{{ i.ch30|delta }}</td>
    <td class="num hide-sm">{{ i.ch90|delta }}</td>
    <td class="num hide-sm">{{ i.off_high|delta }}</td>
    <td class="hide-sm">{{ i.spark|spark }}</td>
  </tr>
  {% endfor %}
  </tbody>
</table></div>
{% endmacro %}

{% for key, items in sections %}
<section id="{{ key }}">
  <h2><span class="sig {{ key }}">{{ signal_info[key][0] }}</span><span class="badge">{{ items|length }}</span></h2>
  <p class="lede">{{ signal_info[key][1] }}</p>
  {% if items %}{{ item_table(items) }}{% else %}<div class="card empty">Nothing matched this week.</div>{% endif %}
</section>
{% endfor %}

<section id="sets">
  <h2>Sets heating up</h2>
  <p class="lede">Whole sets moving together, which often happens when a set goes out of print or a deck gets popular. Median move of singles ≥ {{ min_price|money }}.</p>
  {% if sets_up %}
  <div class="card scroll"><table>
    <thead><tr><th>Set</th><th class="num">Cards</th><th class="num">Median 7d</th><th class="num">Median 30d</th><th class="hide-sm">Share rising</th><th class="hide-sm">Leading card</th></tr></thead>
    <tbody>{% for s in sets_up %}
    <tr><td>{{ s.set }}</td><td class="num">{{ s.cards }}</td><td class="num">{{ s.median7|delta }}</td><td class="num">{{ s.median30|delta }}</td>
      <td class="hide-sm" style="white-space:nowrap">{{ '%.0f'|format(s.up * 100) }}%<span class="bar"><i style="width:{{ '%.0f'|format(s.up * 100) }}%"></i></span></td>
      <td class="hide-sm">{{ s.leader.label }} <span class="na">{{ s.leader.ch7|pct }}</span></td></tr>
    {% endfor %}</tbody>
  </table></div>
  {% else %}<div class="card empty">No set is rising as a whole this week.</div>{% endif %}

  {% if sets_down %}
  <h2>Sets cooling off</h2>
  <div class="card scroll"><table>
    <thead><tr><th>Set</th><th class="num">Cards</th><th class="num">Median 7d</th><th class="num">Median 30d</th><th class="hide-sm">Share rising</th></tr></thead>
    <tbody>{% for s in sets_down %}
    <tr><td>{{ s.set }}</td><td class="num">{{ s.cards }}</td><td class="num">{{ s.median7|delta }}</td><td class="num">{{ s.median30|delta }}</td>
      <td class="hide-sm" style="white-space:nowrap">{{ '%.0f'|format(s.up * 100) }}%<span class="bar"><i style="width:{{ '%.0f'|format(s.up * 100) }}%"></i></span></td></tr>
    {% endfor %}</tbody>
  </table></div>
  {% endif %}
</section>

<section id="sealed">
  <h2>Sealed product</h2>
  <p class="lede">Booster boxes, ETBs, and other sealed products, ranked by 30-day move.</p>
  {% if sealed %}{{ item_table(sealed, show_signal=True) }}{% else %}<div class="card empty">No sealed products above {{ min_price|money }} with enough history.</div>{% endif %}
</section>

{% if watched %}
<section id="watchlist">
  <h2>Your watchlist</h2>
  <p class="lede">Always shown, whatever the price or signal.</p>
  {{ item_table(watched, show_signal=True) }}
</section>
{% endif %}

<section id="explore">
  <h2>Explore all movers</h2>
  <p class="lede">The biggest 7-day movers out of {{ '{:,}'.format(tracked) }} tracked items. Search, filter, and click a column to sort.</p>
  <div class="card">
    <div class="controls">
      <input id="q" type="search" placeholder="Search card or set…" aria-label="Search card or set">
      <select id="fsig" aria-label="Signal"><option value="">All signals</option>
        {% for key, _ in sections %}<option value="{{ key }}">{{ signal_info[key][0] }}</option>{% endfor %}</select>
      <select id="fkind" aria-label="Type"><option value="">Singles &amp; sealed</option><option value="single">Singles</option><option value="sealed">Sealed</option></select>
    </div>
    <div class="scroll"><table id="ex">
      <thead><tr><th data-k="n">Item</th><th class="hide-sm" data-k="sig">Signal</th><th class="num" data-k="p">Price</th><th class="num" data-k="c7">7 days</th>
        <th class="num" data-k="c30">30 days</th><th class="num hide-sm" data-k="c90">90 days</th><th class="hide-sm">Trend</th></tr></thead>
      <tbody></tbody>
    </table></div>
    <div class="empty" id="excount"></div>
  </div>
</section>

<footer>
  <p>Prices: TCGplayer market prices via TCGCSV, snapshot of {{ asof.isoformat() }}. History: {{ history_days }} days ({{ daily_days }} daily points in the last two weeks).
  Generated {{ generated.strftime('%Y-%m-%d %H:%M UTC') }}.</p>
  <p>Market price follows recent sales, but this data has no sales-volume figures, so a thinly traded card can jump on one sale. Check recent sales on TCGplayer before you act. This report is not financial advice.</p>
</footer>
</main>

<script type="application/json" id="exdata">{{ explorer|safe }}</script>
<script>
(() => {
  const rows = JSON.parse(document.getElementById('exdata').textContent);
  const names = {{ signal_names|safe }};
  const tbody = document.querySelector('#ex tbody');
  const q = document.getElementById('q'), fsig = document.getElementById('fsig'), fkind = document.getElementById('fkind');
  let sortKey = 'c7', dir = -1;
  const esc = s => String(s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
  const money = v => v == null ? '–' : '$' + v.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
  const delta = v => {
    if (v == null) return '<span class="na">–</span>';
    const [ic, cls] = v > 0.005 ? ['▲', 'up'] : v < -0.005 ? ['▼', 'down'] : ['■', 'flat'];
    return `<span class="delta"><span class="ic ${cls}" aria-hidden="true">${ic}</span>${v > 0 ? '+' : ''}${(v * 100).toFixed(1)}%</span>`;
  };
  const spark = pts => {
    if (!pts || pts.length < 2) return '<span class="na">–</span>';
    const w = 90, h = 26, p = 3, lo = Math.min(...pts), hi = Math.max(...pts), sy = (hi - lo) || 1;
    const xy = pts.map((v, i) => [p + i / (pts.length - 1) * (w - 2 * p), p + (1 - (v - lo) / sy) * (h - 2 * p)]);
    const [ex, ey] = xy[xy.length - 1];
    return `<svg class="spark" width="${w}" height="${h}" role="img" aria-label="${money(lo)} to ${money(hi)}"><title>Range ${money(lo)}–${money(hi)}</title>` +
      `<polyline points="${xy.map(a => a.map(n => n.toFixed(1)).join(',')).join(' ')}" fill="none" stroke="var(--series-1)" stroke-width="2" stroke-linejoin="round"/>` +
      `<circle cx="${ex.toFixed(1)}" cy="${ey.toFixed(1)}" r="3" fill="var(--series-1)"/></svg>`;
  };
  function draw() {
    const term = q.value.trim().toLowerCase();
    const list = rows.filter(r => (!term || (r.n + ' ' + r.s).toLowerCase().includes(term))
      && (!fsig.value || r.sig === fsig.value) && (!fkind.value || r.k === fkind.value));
    list.sort((a, b) => {
      const x = a[sortKey], y = b[sortKey];
      if (x == null) return 1; if (y == null) return -1;
      return (typeof x === 'string' ? x.localeCompare(y) : x - y) * dir;
    });
    tbody.innerHTML = list.slice(0, 250).map(r => `<tr>
      <td><div class="item"><div><div class="nm">${r.sig ? `<span class="sig ${r.sig}" title="${names[r.sig]}"></span>` : ''}${r.u ? `<a href="${esc(r.u)}" target="_blank" rel="noopener">${esc(r.n)}</a>` : esc(r.n)}</div>
        <div class="meta">${esc(r.s)}${r.r ? ' · ' + esc(r.r) : ''}</div></div></div></td>
      <td class="hide-sm">${r.sig ? `<span class="sig ${r.sig}">${names[r.sig]}</span>` : '<span class="na">none</span>'}</td>
      <td class="num">${money(r.p)}</td><td class="num">${delta(r.c7)}</td><td class="num">${delta(r.c30)}</td>
      <td class="num hide-sm">${delta(r.c90)}</td><td class="hide-sm">${spark(r.sp)}</td></tr>`).join('');
    document.getElementById('excount').textContent =
      `${list.length.toLocaleString()} matching${list.length > 250 ? ' (showing the first 250)' : ''}`;
    document.querySelectorAll('#ex th[data-k]').forEach(th => {
      th.querySelector('.arrow')?.remove();
      if (th.dataset.k === sortKey) th.insertAdjacentHTML('beforeend', ` <span class="arrow">${dir < 0 ? '▼' : '▲'}</span>`);
    });
  }
  document.querySelectorAll('#ex th[data-k]').forEach(th => th.addEventListener('click', () => {
    dir = th.dataset.k === sortKey ? -dir : (['n', 'sig'].includes(th.dataset.k) ? 1 : -1);
    sortKey = th.dataset.k; draw();
  }));
  [q, fsig, fkind].forEach(el => el.addEventListener('input', draw));
  draw();
})();
</script>
</body>
</html>
